digraph {
overlap=scale;
labelloc="t";
label="Agram";
fontname="Futura";
subgraph cluster_table {
style=filled;fillcolor=ghostwhite;label="table"
table_INVISIBLE_STOCK_0 [fontname=Futura,penwidth=3,fillcolor=khaki,style="filled,rounded",shape=box,label=STOCK];
table_VISIBLE_DISCARD_0 [fontname=Futura,fillcolor=lightgreen,style="filled,rounded",shape=box,label=DISCARD];
}
subgraph cluster_p1 {
style=filled;fillcolor=ghostwhite;label="p1"
p1_INVISIBLE_HAND_0 [fontname=Futura,fillcolor=lightblue,style="filled,rounded",shape=box,label=HAND];
p1_VISIBLE_TRICK_0 [fontname=Futura,fillcolor=lightgreen,style="filled,rounded",shape=box,label=TRICK];
}
