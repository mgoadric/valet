p3_VISIBLE_TRICK_0 [fontname=Futura,fillcolor=lightgreen,style="filled,rounded",shape=box,label=TRICK];
}
table_INVISIBLE_STOCK_0 -> p1_INVISIBLE_HAND_0 [fontname=Futura,fontsize=11,color=black];
table_INVISIBLE_STOCK_0 -> p2_INVISIBLE_HAND_0 [fontname=Futura,fontsize=11,color=black];
table_INVISIBLE_STOCK_0 -> p3_INVISIBLE_HAND_0 [fontname=Futura,fontsize=11,color=black];
p1_INVISIBLE_HAND_0 -> p1_VISIBLE_TRICK_0 [fontname=Futura,fontsize=11,color=green,penwidth=3,];
p2_INVISIBLE_HAND_0 -> p2_VISIBLE_TRICK_0 [fontname=Futura,fontsize=11,color=green,penwidth=3,];
p3_INVISIBLE_HAND_0 -> p3_VISIBLE_TRICK_0 [fontname=Futura,fontsize=11,color=green,penwidth=3,];
p1_VISIBLE_TRICK_0 -> table_VISIBLE_DISCARD_0 [fontname=Futura,fontsize=11,color=green,penwidth=3,];
